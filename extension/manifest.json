{
  "manifest_version": 3,
  "name": "LearnLoop Companion — LeetCode Speed & Submission Tracker",
  "version": "1.0.0",
  "description": "Automatically tracks your time per LeetCode problem, records runtime and memory, and syncs submissions to LearnLoop.ai.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://leetcode.com/*",
    "http://localhost:5001/*",
    "http://127.0.0.1:5001/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://leetcode.com/problems/*"],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ]
}
